{
  "name": "@hotox/claude-auto",
  "version": "0.6.0",
  "description": "Auto-continue for Claude Code. Waits out your usage limit and resumes the session automatically",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["claude", "claude-code", "cli", "auto-resume", "auto-continue", "claude-auto-resume", "claude-auto-continue", "usage-limit"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkblader24/claude-auto.git"
  },
  "bugs": {
    "url": "https://github.com/Darkblader24/claude-auto/issues"
  },
  "homepage": "https://github.com/Darkblader24/claude-auto#readme",
  "type": "module",
  "bin": {
    "claude-auto": "dist/claude-auto.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": ["win32", "darwin", "linux"],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "claude": "bunx tsx claude-auto.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "tsc --project tsconfig.build.json"
  }
}
